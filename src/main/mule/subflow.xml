	"Content-Type" : "application/octet-stream",
	"password" : "sdfvklj40934tsdlvjk309sd",
	"svc_name" : "CheckApplicationStatus",
	"authorization" : "Bearer " ++ (vars.hmsiToken.access_token)
}]]]></http:headers>
