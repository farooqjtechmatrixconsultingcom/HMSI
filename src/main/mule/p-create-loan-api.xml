			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "requestHeaderSource": "TWonline",
    "svcName": "UPDATELOAN",
    "applicationId": "10000057324",

    "cartInfo": vars.globalPayload.cartInfo map ((cart) -> {
        "brand": cart.brand,
        "itemIdentifier": cart.itemIdentifier,
        "assetGroup": cart.assetGroup,
        "promoid": cart.promoid,
        "tenure": cart.tenure,
        "supplier_code": cart.supplier_code,
        "marginmoney": cart.marginmoney,
        "productSku": cart.productSku,
        "offerScheme": cart.offerScheme,
        "assetcost": cart.assetcost,
        "isSupplierEditable": cart.isSupplierEditable
    }),
    "customerProfile": [
        {
            "partnerCustomerIdentifier": 
                (vars.globalPayload.customerProfile[0].partnerCustomerIdentifier as Number default 0),
            "bankingDetails": 
                if (!isEmpty(vars.globalPayload.customerProfile[0].bankingDetails)) 
                do { vars.globalPayload.customerProfile[0].bankingDetails } 
                else [],
            "liability": 
                if (!isEmpty(vars.globalPayload.customerProfile[0].liability)) 
                do { vars.globalPayload.customerProfile[0].liability } 
                else [],
            "employmentInfo": vars.globalPayload.customerProfile[0].employmentInfo map ((emp) -> {
                "employmentType": emp.employmentType,
                "employerName": emp.employerName,
                "annualGrossSalary": emp.annualGrossSalary
            })
        }
    ],
    "incomeDetails": 
        if (!isEmpty(vars.globalPayload.customerProfile[0].incomeDetails)) 
        do { vars.globalPayload.customerProfile[0].incomeDetails } 
        else [],
    "reference": vars.globalPayload.reference map ((ref) -> {
        "referenceRelationToCustomer": ref.referenceRelationToCustomer,
        "referenceTitle": ref.referenceTitle,
        "referenceFirstName": ref.referenceFirstName,
        "referenceMiddleName": ref.referenceMiddleName,
        "referenceLastName": ref.referenceLastName,
        "referenceMobilePhoneNumber": ref.referenceMobilePhoneNumber,
        "address": 
            if (!isEmpty(ref.address)) 
            do { 
                ref.address map ((addr) -> {
                    "addressLine1": addr.addressLine1,
                    "addressLine2": addr.addressLine2,
                    "addressLine3": addr.addressLine3,
                    "state": addr.state,
                    "city": addr.city,
                    "landmark": addr.landmark,
                    "pincode": addr.pincode,
                    "addressType": addr.addressType,
                    "propertyStatus": addr.propertyStatus,
                    "mailingAddress": addr.mailingAddress,
                    "sameAsCurrentAddress": addr.sameAsCurrentAddress
                })
            } 
            else []
    }),
    "offers": 
        (vars.globalPayload.offers as Array default []),
    "surrogateInfo": 
        if (vars.globalPayload.surrogateInfo != []) vars.globalPayload.surrogateInfo[0] else [],
    "consumerConsent": null
}
]]></ee:set-payload>
