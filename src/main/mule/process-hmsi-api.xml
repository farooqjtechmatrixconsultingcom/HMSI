    <flow name="post:\getActiveLoanEBC:application\json:process-hmsi-api-config">
        <ee:transform doc:name="Raw Payload" doc:id="6d849161-4ccd-4332-9a9a-5c3c417058b3" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<set-variable value="#[payload]" doc:name="Payload Variable" doc:id="86ec14d5-84a8-44fc-89f0-9f2e325fabc2" variableName="rawPayload" />
        <flow-ref doc:name="Get EBC Limit" doc:id="c5104f49-410a-4929-8831-2b4edde5397d" name="process-getebc-hmsi-apiSub_Flow"/>
        <flow-ref doc:name="Get Active Loan" doc:id="cf5fd977-384a-40d1-9fe7-2578ae796349" name="process-hmsi-getactiveloan-apiSub_Flow"/>
		<ee:transform doc:name="Transform Message" doc:id="695280ca-9423-4b3e-8cdf-7e4a6b0e1170">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
[
  {
    "availableOffer": (vars.getEbcPayload.EBCLimit as Number default 0),
      "activeLoan": if (vars.getActiveLoanPayload.Response[0] != null) "Yes" else "No",
   "activeLoanNumber": 
      vars.getActiveLoanPayload.Response map ((loan) -> {
        "loanNumber": loan.loanApplicationNumber,
        "createdDate": loan.loanCreationDate 
      }),
    "module": "IDFC"
  },
  {
    "availableOffer": (vars.getEbcPayload.EBCLimit as Number default 0),
    "activeLoan": "No",
    "activeLoanNumber": null,
    "module": "L&T"
  }
]]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <logger level="INFO" doc:name="Logger" doc:id="66cc6d51-3f9e-4801-b124-e4d548e2585c" message="#[vars.getActiveLoanapiPayload.Response]" />
    </flow>
