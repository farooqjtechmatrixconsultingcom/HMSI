#%RAML 1.0 DataType 
type: object
properties:
  isLoanCancel:
    type: string
    example: 'Yes'
    required: false
  requestHeaderSource:
    type: string
    example: Twonline
    required: false
  svcName:
    type: string
    example: CREATELOAN
    required: false
  partnerName:
    type: string
    example: Honda_TW
    required: false
  location:
    type: string
    example: MUMBAI
    required: false
  lob:
    type: string
    example: TW
    required: false
  createdBy:
    type: nil
    example: null
    required: false
  loanSource:
    type: string
    example: TW-Online
    required: false
  isOTPRequired:
    type: boolean
    example: false
    required: false
  customerProfile:
    type: array
    items:
      type: object
      properties:
        partnerCustomerIdentifier:
          type: nil
          example: null
          required: false
        gender:
          type: string
          example: Female
          required: false
        maritalStatus:
          type: string
          example: Married
          required: false
        firstName:
          type: string
          example: Anand
          required: false
        lastName:
          type: string
          example: Panday
          required: false
        fatherFirstName:
          type: string
          example: Sunil
          required: false
        fatherLastName:
          type: string
          example: Kumar
          required: false
        motherFirstName:
          type: string
          example: Babita
          required: false
        motherLastName:
          type: string
          example: Devi
          required: false
        spouseFirstName:
          type: string
          example: Ankit
          required: false
        spouseLastName:
          type: string
          example: Chauhan
          required: false
        applicantType:
          type: string
          example: Applicant
          required: false
        mobileNumber:
          type: string
          example: '7875672167'
          required: false
        emailId:
          type: string
          example: shruti.dinnimani0905@gmail.com
          required: false
        dateOfBirth:
          type: string
          example: 19-05-1995
          required: false
        identifier:
          type: array
          items:
            type: object
            properties:
              type:
                type: string
                example: PAN
                required: false
              value:
                type: string
                example: BVZPH3167F
                required: false
        address:
          type: array
          items:
            type: object
            properties:
              addressLine1:
                type: string
                example: K H NO 3 MAKRAMMATPUR SIKROAD MAKARMAT P
                required: false
              addressLine2:
                type: string
                example: GHAZIABAD
                required: false
              addressLine3:
                type: string
                example: Ghaziabad
                required: false
              state:
                type: nil
                example: null
                required: false
              city:
                type: nil
                example: null
                required: false
              landmark:
                type: nil
                example: null
                required: false
              pincode:
                type: string
                example: '201003'
                required: false
              addressType:
                type: string
                example: RESIDENCE ADDRESS
                required: false
              propertyStatus:
                type: string
                example: O
                required: false
              mailingAddress:
                type: string
                example: 'YES'
                required: false
              sameAsCurrentAddress:
                type: boolean
                example: false
                required: false
        employmentInfo:
          type: array
          items:
            type: object
            properties:
              employmentType:
                type: string
                example: Salaried
                required: false
              employerName:
                type: string
                example: IDFC BANK
                required: false
              annualGrossSalary:
                type: integer
                example: 600000
                required: false
              typeOfOrganisation:
                type: string
                example: Private Limited Company
                required: false
        incomeDetails:
          type: nil
          example: null
          required: false
        liability:
          type: array
          items: {}
        bankingDetails:
          type: array
          items: {}
  offers:
    type: nil
    example: null
    required: false
  documents:
    type: nil
    example: null
    required: false
  consumerConsent:
    type: nil
    example: null
    required: false
  campaignDetails:
    type: nil
    example: null
    required: false
  salespoint_code:
    type: nil
    example: null
    required: false
  cartInfo:
    type: array
    items:
      type: object
      properties:
        assetcost:
          type: integer
          example: 90000
          required: false
        assetGroup:
          type: string
          example: '56'
          required: false
        brand:
          type: string
          example: '1111'
          required: false
        isSupplierEditable:
          type: boolean
          example: true
          required: false
        itemIdentifier:
          type: string
          example: item123
          required: false
        marginmoney:
          type: integer
          example: 40000
          required: false
        offerScheme:
          type: string
          example: '182'
          required: false
        productSku:
          type: string
          example: '1984930'
          required: false
        promoid:
          type: string
          example: '175'
          required: false
        supplier_code:
          type: string
          example: '3665'
          required: false
        tenure:
          type: integer
          example: 24
          required: false
  reference:
    type: array
    items:
      type: object
      properties:
        address:
          type: array
          items: {}
        referenceFirstName:
          type: string
          example: gjklh
          required: false
        referenceLastName:
          type: string
          example: ythgfgj
          required: false
        referenceMiddleName:
          type: string
          example: yjghk
          required: false
        referenceMobilePhoneNumber:
          type: string
          example: ''
          required: false
        referenceRelationToCustomer:
          type: string
          example: FRIEND
          required: false
        referenceTitle:
          type: string
          example: Mr
          required: false
  surrogateInfo:
    type: array
    items: {}
